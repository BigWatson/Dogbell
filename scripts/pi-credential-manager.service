[Unit]
Description=Raspberry Pi Doorbell Credential Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
ExecStart=/usr/bin/python3 /home/pi/scripts/pi_credential_manager.py --pi-id DOGBELL-001 --broker broker.hivemq.com
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target